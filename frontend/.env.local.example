# ============================================================
# BrandCommand frontend — environment
# Copy to .env.local. All three are required: NEXT_PUBLIC_*
# values are inlined at build time, so they must be present
# when you run `next build`, not just at runtime.
# ============================================================

# ---- Supabase ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key only. The service role key must never appear in frontend env.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Backend API -------------------------------------------
# Origin of the FastAPI service, no trailing slash.
# Must be listed in the backend's CORS origins (it derives them from FRONTEND_URL).
NEXT_PUBLIC_API_URL=http://localhost:8000
