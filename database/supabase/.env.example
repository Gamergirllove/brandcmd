# ============================================================
# Supabase Environment Variables — Creator Analytics Platform
# ============================================================
# Copy this file to .env.local (Next.js) or .env and fill in
# real values. NEVER commit the filled-in file to version control.

# ------------------------------------------------------------------
# Supabase core — found in your project's Settings > API page
# https://app.supabase.com/project/<your-project>/settings/api
# ------------------------------------------------------------------

# Public URL for your Supabase project (safe to expose to the browser).
SUPABASE_URL=https://<your-project-ref>.supabase.co
# For local dev: SUPABASE_URL=http://localhost:54321

# Anon key — public, read-only default key (safe to expose to the browser).
SUPABASE_ANON_KEY=<your-anon-key>

# Service role key — NEVER expose to the browser or commit.
# Used by backend workers and Edge Functions that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ------------------------------------------------------------------
# pgcrypto / token encryption
# A random 32+ byte secret used by pgp_sym_encrypt / pgp_sym_decrypt.
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------
PG_ENCRYPTION_SECRET=<random-32+-byte-secret>

# ------------------------------------------------------------------
# Fernet encryption (application layer — double-encryption for tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------------------------------
FERNET_SECRET_KEY=<fernet-key>

# ------------------------------------------------------------------
# Google / YouTube
# https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ------------------------------------------------------------------
# Meta (Facebook + Instagram)
# https://developers.facebook.com/apps/
# ------------------------------------------------------------------
FACEBOOK_APP_ID=<your-facebook-app-id>
FACEBOOK_APP_SECRET=<your-facebook-app-secret>

# ------------------------------------------------------------------
# TikTok
# https://developers.tiktok.com/
# ------------------------------------------------------------------
TIKTOK_CLIENT_KEY=<your-tiktok-client-key>
TIKTOK_CLIENT_SECRET=<your-tiktok-client-secret>

# ------------------------------------------------------------------
# Twitter / X
# https://developer.twitter.com/en/portal/dashboard
# ------------------------------------------------------------------
TWITTER_CLIENT_ID=<your-twitter-client-id>
TWITTER_CLIENT_SECRET=<your-twitter-client-secret>

# ------------------------------------------------------------------
# Pinterest
# https://developers.pinterest.com/apps/
# ------------------------------------------------------------------
PINTEREST_APP_ID=<your-pinterest-app-id>
PINTEREST_APP_SECRET=<your-pinterest-app-secret>

# ------------------------------------------------------------------
# LinkedIn
# https://www.linkedin.com/developers/apps
# ------------------------------------------------------------------
LINKEDIN_CLIENT_ID=<your-linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<your-linkedin-client-secret>

# ------------------------------------------------------------------
# Snapchat
# https://kit.snapchat.com/manage/
# ------------------------------------------------------------------
SNAPCHAT_CLIENT_ID=<your-snapchat-client-id>
SNAPCHAT_CLIENT_SECRET=<your-snapchat-client-secret>

# ------------------------------------------------------------------
# App URLs
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://your-production-domain.com
