# Secrets — never commit real credentials.
# Every folder keeps its own .env; only .example files belong in git.
.env
.env.local
.env.*.local

# Deployment-specific notes. Not secrets, but there's no reason to publish
# your project refs and domains to a public repo — it puts them on the
# lists that bots scan for misconfigured databases.
*.local.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node
node_modules/
.next/
out/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
