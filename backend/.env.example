# ============================================================
# BrandCommand API — environment
# Copy to .env and fill in. Only Supabase + the platforms you
# actually want to offer are required; unconfigured platforms
# are reported as `configured: false` and hidden in the UI.
# ============================================================

# ---- Supabase (required) -----------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-side only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- App config (required) ---------------------------------
# Where the browser gets sent after an OAuth round trip.
FRONTEND_URL=http://localhost:3000
# Public URL of THIS service. OAuth callbacks are built from it, so it must
# match the redirect URI registered with each provider exactly.
BACKEND_URL=http://localhost:8000

# Used to derive the token encryption key when TOKEN_ENCRYPTION_KEY is unset.
SECRET_KEY=your-very-secret-key-change-in-production
# Preferred: a real Fernet key. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes every stored platform token unreadable — users must reconnect.
TOKEN_ENCRYPTION_KEY=

# ---- MVP platforms -----------------------------------------
# Twitch — https://dev.twitch.tv/console/apps
# Redirect URI: ${BACKEND_URL}/connect/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube via Google Cloud Console (OAuth client, Web application).
# Enable the YouTube Data API v3 and YouTube Analytics API.
# Redirect URI: ${BACKEND_URL}/connect/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Additional platforms (optional) -----------------------
# Each redirect URI follows the same pattern:
#   ${BACKEND_URL}/connect/<platform>/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok issues a "client key" rather than a client id.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
